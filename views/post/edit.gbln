
<{ render }>

<{
use graveyard

act query_get(query, key)
    prefix | key + "="

    for pair in :split(query, "&")
        if :starts_with(pair, prefix)
            value | :keep_after(pair, prefix)
            return :url_decode(value)
        xx
    xx

    return ..
xx

query | :req_query()
id_raw | query_get(query, "id")
id     | ..

if id_raw.nix? == false
    id |= :int(id_raw)
xx

version | graveyard::latest_version("post", id)

shard | graveyard::read_shard("post", id, version)
meta       | shard{"meta"}
shard_body | shard{"body"}
title | meta{"title"}
body | shard_body

}>

<!doctype html>
<html>
<head>
    <title>Edit Post</title>
</head>
<body>
    <h1>Edit Post</h1>

    <form method="POST" action="/actions/post.gbln?id=<{id}>">

        <p>
            <label>Title</label><br>
            <input type="text" name="title" value="<{ title }>">
        </p>


        <p>
            <label>Body</label><br>
            <textarea name="body"><{ body }></textarea>
        </p>


        <p>
            <button type="submit">Save Post</button>
        </p>
    </form>
</body>
</html>
