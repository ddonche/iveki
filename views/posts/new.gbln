<{ render }>

<{ 
query | :req_query()
created | :contains(query, "created=1")
}>

<!doctype html>
<html>
<head>
    <title>New Post</title>
</head>
<body>
    <h1>New Post</h1>

    <{ if created }>
        <p><strong>Shard created.</strong></p>
    <{ xx }>

    <form method="POST" action="/actions/posts.gbln">
        <p>
            <label>Title</label><br>
            <input type="text" name="title">
        </p>

        <p>
            <label>Body</label><br>
            <textarea name="body"></textarea>
        </p>

        <p>
            <button type="submit">Create Post</button>
        </p>
    </form>
</body>
</html>