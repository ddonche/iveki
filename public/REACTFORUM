                      gap: '1.5rem'
                    }}>
                      <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                        <div style={{
                          width: '20px',
                          height: '20px',
                          borderRadius: '50%',
                          backgroundColor: '#e9ecef',
                          display: 'flex',
                          alignItems: 'center',
                          justifyContent: 'center',
                          fontSize: '0.65rem',
                          fontWeight: '600',
                          color: '#6c757d'
                        }}>
                          {topic.author.initials}
                        </div>
                        <span>{topic.author.name}</span>
                      </div>

                      <div style={{ display: 'flex', alignItems: 'center', gap: '0.35rem' }}>
                        <CommentIcon />
                        <span style={{ fontWeight: '500' }}>{topic.replies}</span>
                      </div>

                      <div style={{ display: 'flex', alignItems: 'center', gap: '0.35rem' }}>
                        <EyeIcon />
                        <span>{topic.views}</span>
                      </div>
                    </div>
                  </div>

                  {/* Commenter avatars */}
                  <div style={{
                    display: 'flex',
                    alignItems: 'center',
                    gap: '0.25rem',
                    flexShrink: 0
                  }}>
                    {topic.commenters.slice(0, 5).map((commenter, idx) => (
                      <div key={idx} style={{
                        width: '28px',
                        height: '28px',
                        borderRadius: '50%',
                        backgroundColor: '#e9ecef',
                        border: '2px solid white',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'center',
                        fontSize: '0.7rem',
                        fontWeight: '600',
                        color: '#6c757d',
                        marginLeft: idx > 0 ? '-10px' : '0'
                      }}>
                        {commenter.initials}
                      </div>
                    ))}
                    {topic.commenters.length > 5 && (
                      <div style={{
                        fontSize: '0.75rem',
                        color: '#6c757d',
                        fontWeight: '500',
                        marginLeft: '0.5rem'
                      }}>
                        +{topic.commenters.length - 5}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </main>

        {/* Right Sidebar */}
        <aside>
          {/* Hot Topics */}
          <div style={{
            backgroundColor: 'white',
            border: '1px solid #dee2e6',
            borderRadius: '4px',
            padding: '1rem',
            marginBottom: '1.5rem'
          }}>
            <div style={{
              fontSize: '0.75rem',
              fontWeight: '700',
              color: '#6c757d',
              marginBottom: '0.75rem',
              textTransform: 'uppercase',
              letterSpacing: '0.5px'
            }}>
              🔥 Hot Topics
            </div>
            {hotTopics.map((topic, idx) => (
              <div key={idx} style={{
                padding: '0.75rem 0',
                borderBottom: idx < hotTopics.length - 1 ? '1px solid #e9ecef' : 'none',
                display: 'flex',
                gap: '0.75rem'
              }}>
                <div style={{
                  width: '3px',
                  backgroundColor: topic.categoryColor,
                  borderRadius: '2px',
                  flexShrink: 0
                }} />
                <div style={{ flex: 1 }}>
                  <div style={{
                    fontSize: '0.85rem',
                    color: '#212529',
                    marginBottom: '0.35rem',
                    fontWeight: '500',
                    lineHeight: '1.3',
                    cursor: 'pointer'
                  }}>
                    {topic.title}
                  </div>
                  <div style={{
                    fontSize: '0.75rem',
                    color: '#6c757d',
                    display: 'flex',
                    alignItems: 'center',
                    gap: '0.35rem'
                  }}>
                    <CommentIcon />
                    {topic.replies} replies
                  </div>
                </div>
              </div>
            ))}
          </div>

          {/* Unanswered */}
          <div style={{
            backgroundColor: 'white',
            border: '1px solid #dee2e6',
            borderRadius: '4px',
            padding: '1rem',
            marginBottom: '1.5rem'
          }}>
            <div style={{
              fontSize: '0.75rem',
              fontWeight: '700',
              color: '#6c757d',
              marginBottom: '0.75rem',
              textTransform: 'uppercase',
              letterSpacing: '0.5px'
            }}>
              ❓ Unanswered
            </div>
            {unanswered.map((topic, idx) => (
              <div key={idx} style={{
                padding: '0.75rem 0',
                borderBottom: idx < unanswered.length - 1 ? '1px solid #e9ecef' : 'none',
                display: 'flex',
                gap: '0.75rem'
              }}>
                <div style={{
                  width: '3px',
                  backgroundColor: topic.categoryColor,
                  borderRadius: '2px',
                  flexShrink: 0
                }} />
                <div style={{ flex: 1 }}>
                  <div style={{
                    fontSize: '0.85rem',
                    color: '#212529',
                    marginBottom: '0.35rem',
                    fontWeight: '500',
                    lineHeight: '1.3',
                    cursor: 'pointer'
                  }}>
                    {topic.title}
                  </div>
                  <div style={{
                    fontSize: '0.75rem',
                    color: '#6c757d',
                    display: 'flex',
                    alignItems: 'center',
                    gap: '0.35rem'
                  }}>
                    <EyeIcon />
                    {topic.views} views
                  </div>
                </div>
              </div>
            ))}
          </div>

          {/* Questions */}
          <div style={{
            backgroundColor: 'white',
            border: '1px solid #dee2e6',
            borderRadius: '4px',
            padding: '1rem'
          }}>
            <div style={{
              fontSize: '0.75rem',
              fontWeight: '700',
              color: '#6c757d',
              marginBottom: '0.75rem',
              textTransform: 'uppercase',
              letterSpacing: '0.5px'
            }}>
              ❔ Questions
            </div>
            <div style={{
              fontSize: '0.85rem',
              color: '#6c757d',
              fontStyle: 'italic'
            }}>
              Question topics appear here...
            </div>
          </div>
        </aside>
      </div>
    </div>
  );
}