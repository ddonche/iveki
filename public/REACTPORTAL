                  border: 'none',
                  backgroundColor: activeTab === tab.toLowerCase().replace(' ', '-') ? '#f8f9fa' : 'transparent',
                  borderBottom: activeTab === tab.toLowerCase().replace(' ', '-') ? '3px solid #f9a825' : '3px solid transparent',
                  color: activeTab === tab.toLowerCase().replace(' ', '-') ? '#212529' : '#6c757d',
                  fontWeight: activeTab === tab.toLowerCase().replace(' ', '-') ? '600' : '400',
                  cursor: 'pointer',
                  fontSize: '0.9rem',
                  borderRadius: '3px 3px 0 0'
                }}
              >
                {tab}
              </button>
            ))}
          </div>

          {/* Tab Content */}
          <div style={{
            backgroundColor: '#f8f9fa',
            border: '1px solid #dee2e6',
            borderRadius: '0 0 4px 4px',
            padding: '1.5rem'
          }}>
            {activeTab === 'activity' || activeTab === 'all-activity' ? (
              <div>
                {posts.map(post => (
                  <article key={post.id} style={{
                    backgroundColor: 'white',
                    border: '1px solid #dee2e6',
                    borderRadius: '4px',
                    marginBottom: '1rem'
                  }}>
                    <div style={{ padding: '1.25rem' }}>
                      <div style={{ display: 'flex', alignItems: 'center', marginBottom: '1rem' }}>
                        <div style={{
                          width: '32px',
                          height: '32px',
                          borderRadius: '3px',
                          backgroundColor: '#e9ecef',
                          marginRight: '0.75rem',
                          display: 'flex',
                          alignItems: 'center',
                          justifyContent: 'center',
                          fontSize: '0.85rem',
                          fontWeight: '600',
                          color: '#6c757d'
                        }}>{post.author[0]}</div>
                        <div>
                          <div style={{ fontWeight: '500', fontSize: '0.9rem', color: '#212529', display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                            {post.author}
                            <span style={{ fontSize: '1rem' }} title={post.countryName}>🇺🇸</span>
                          </div>
                          <div style={{ fontSize: '0.8rem', color: '#6c757d' }}>
                            {post.time}
                          </div>
                        </div>
                      </div>

                      <p style={{ lineHeight: '1.6', marginBottom: '1rem', fontSize: '0.95rem', color: '#212529' }}>
                        {post.content}
                      </p>

                      <div style={{ display: 'flex', gap: '0.5rem', flexWrap: 'wrap' }}>
                        {post.tags.map(tag => (
                          <span key={tag} style={{
                            backgroundColor: '#e7f5ff',
                            color: '#0969da',
                            padding: '0.25rem 0.6rem',
                            borderRadius: '3px',
                            fontSize: '0.8rem',
                            fontWeight: '500'
                          }}>{tag}</span>
                        ))}
                      </div>
                    </div>

                    <div style={{
                      display: 'flex',
                      justifyContent: 'space-between',
                      alignItems: 'center',
                      padding: '0.75rem 1.25rem',
                      borderTop: '1px solid #e9ecef',
                      fontSize: '0.85rem',
                      color: '#6c757d',
                      backgroundColor: '#f8f9fa'
                    }}>
                      <div style={{ display: 'flex', gap: '1.25rem' }}>
                        <button style={{
                          backgroundColor: 'transparent',
                          border: 'none',
                          cursor: 'pointer',
                          display: 'flex',
                          alignItems: 'center',
                          gap: '0.4rem',
                          color: '#6c757d',
                          fontSize: '0.85rem',
                          fontWeight: '500',
                          padding: '0'
                        }}>
                          <span style={{ fontSize: '1rem' }}>▲</span> {post.likes}
                        </button>
                        <button style={{
                          backgroundColor: 'transparent',
                          border: 'none',
                          cursor: 'pointer',
                          color: '#6c757d',
                          fontSize: '0.85rem',
                          fontWeight: '500',
                          padding: '0',
                          display: 'flex',
                          alignItems: 'center',
                          gap: '0.4rem'
                        }}>
                          <CommentIcon />
                          {post.comments}
                        </button>
                        <button style={{
                          backgroundColor: 'transparent',
                          border: 'none',
                          cursor: 'pointer',
                          color: '#6c757d',
                          fontSize: '0.85rem',
                          fontWeight: '500',
                          padding: '0',
                          display: 'flex',
                          alignItems: 'center',
                          gap: '0.4rem'
                        }}>
                          <LinkIcon />
                          {post.citations}
                        </button>
                      </div>
                      <div style={{ display: 'flex', gap: '1rem' }}>
                        <button style={{
                          backgroundColor: 'transparent',
                          border: 'none',
                          cursor: 'pointer',
                          color: '#6c757d',
                          padding: '0',
                          display: 'flex',
                          alignItems: 'center'
                        }}>
                          <ShareIcon />
                        </button>
                        <button style={{
                          backgroundColor: 'transparent',
                          border: 'none',
                          cursor: 'pointer',
                          color: '#6c757d',
                          padding: '0',
                          display: 'flex',
                          alignItems: 'center'
                        }}>
                          <BookmarkIcon />
                        </button>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <p style={{ color: '#6c757d', fontSize: '0.9rem' }}>
                {activeTab === 'questions' && 'Questions in this portal...'}
                {activeTab === 'polls' && 'Polls in this portal...'}
                {activeTab === 'trivia' && 'Trivia questions in this portal...'}
              </p>
            )}
          </div>
        </main>

        {/* Right Sidebar */}
        <aside>
          {/* Chat Room */}
          <div style={{
            backgroundColor: 'white',
            border: '1px solid #dee2e6',
            borderRadius: '4px',
            padding: '1rem',
            marginBottom: '1.5rem'
          }}>
            <div style={{ fontSize: '0.75rem', fontWeight: '700', color: '#6c757d', marginBottom: '0.75rem', textTransform: 'uppercase', letterSpacing: '0.5px' }}>
              Live Chat
            </div>
            <div style={{
              backgroundColor: '#f8f9fa',
              border: '1px solid #dee2e6',
              borderRadius: '4px',
              padding: '1rem',
              minHeight: '200px',
              marginBottom: '0.75rem',
              fontSize: '0.85rem',
              color: '#6c757d',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center'
            }}>
              Chat messages appear here...
            </div>
            <input type="text" placeholder="Type a message..." style={{
              width: '100%',
              padding: '0.5rem',
              border: '1px solid #dee2e6',
              borderRadius: '3px',
              fontSize: '0.85rem'
            }} />
          </div>

          {/* Courses */}
          <div style={{
            backgroundColor: 'white',
            border: '1px solid #dee2e6',
            borderRadius: '4px',
            padding: '1rem'
          }}>
            <div style={{ fontSize: '0.75rem', fontWeight: '700', color: '#6c757d', marginBottom: '0.75rem', textTransform: 'uppercase', letterSpacing: '0.5px' }}>
              Courses
            </div>
            {courses.map((course, idx) => (
              <div key={course.name} style={{
                padding: '0.75rem 0',
                borderBottom: idx < courses.length - 1 ? '1px solid #e9ecef' : 'none'
              }}>
                <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', marginBottom: '0.5rem' }}>
                  <div style={{
                    width: '32px',
                    height: '32px',
                    backgroundColor: course.color,
                    borderRadius: '4px',
                    flexShrink: 0
                  }} />
                  <div style={{ fontWeight: '500', fontSize: '0.9rem', color: '#212529', flex: 1 }}>
                    {course.name}
                  </div>
                  <button style={{
                    backgroundColor: '#f9a825',
                    color: '#1a2332',
                    border: 'none',
                    padding: '0.25rem 0.6rem',
                    borderRadius: '3px',
                    cursor: 'pointer',
                    fontSize: '0.75rem',
                    fontWeight: '500',
                    flexShrink: 0
                  }}>Enroll</button>
                </div>
                <div style={{ fontSize: '0.75rem', color: '#6c757d', marginBottom: '0.35rem' }}>{course.instructor}</div>
                <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', fontSize: '0.75rem' }}>
                  <div style={{ display: 'flex', alignItems: 'center', gap: '0.75rem' }}>
                    <div style={{ color: '#f9a825' }}>★ {course.rating}</div>
                    <div style={{ color: '#6c757d', display: 'flex', alignItems: 'center', gap: '0.35rem' }}>
                      <PeopleIcon />
                      {course.students.toLocaleString()}
                    </div>
                  </div>
                  <div style={{ fontWeight: '600', color: course.price === 'Free' ? '#10b981' : '#212529' }}>
                    {course.price}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </aside>
      </div>
    </div>
  );
}